# =================================
# VELTRIZ GAME WORLD SERVICE - ENV
# =================================

APP_NAME=Veltriz
NODE_ENV=development
PORT=5002

CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Same MongoDB cluster/database as auth-service and economy-service
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/veltriz

# MUST match auth-service's JWT_SECRET exactly
JWT_SECRET=change_this_super_long_random_secret

# Used to call economy-service's wallet init endpoint when a character is
# created (forwards the player's own Authorization header — this is NOT
# the internal admin key, just a normal service URL)
ECONOMY_SERVICE_URL=http://localhost:5001

# Shared internal service-to-service key — MUST match economy-service's
# INTERNAL_API_KEY exactly. Used two ways:
#  1. authenticates economy-service's inbound calls to THIS service's
#     /api/internal/* (e.g. applying a consumable item's stat effects)
#  2. authenticates THIS service's outbound calls to economy-service's
#     /api/internal/wallets/:userId/debit (charging the Gym's workout fee —
#     see src/services/economyClient.js)
INTERNAL_API_KEY=change_this_to_a_long_random_shared_secret

# How often (ms) a connected player's position is persisted to MongoDB.
# Real-time sync between players happens instantly over sockets regardless —
# this only controls how often we write to disk for "resume where you left off".
POSITION_SAVE_INTERVAL_MS=5000
