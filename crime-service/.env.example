# =================================
# VELTRIZ CRIME SERVICE - ENV
# =================================

APP_NAME=Veltriz
NODE_ENV=development
PORT=5005

CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Same MongoDB cluster/database as the other services
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/veltriz

# MUST match auth-service's JWT_SECRET exactly (player-facing routes verify
# the same access token every other service does)
JWT_SECRET=change_this_super_long_random_secret

# Shared internal service-to-service key — MUST match every other service's
# INTERNAL_API_KEY exactly. Used two ways here:
#  1. admin-service calls THIS service's /api/internal/* routes with it
#     (crime action CRUD, heat leaderboard/reset — see internalAuth.middleware.js)
#  2. THIS service calls economy-service's /api/internal/wallets/:userId/credit
#     with it, to pay out successful crime attempts (see services/economyClient.js)
INTERNAL_API_KEY=change_this_to_a_long_random_shared_secret

ECONOMY_SERVICE_URL=http://localhost:5001

# How much heat drains automatically, and how often, so heat isn't permanent
# without an admin resetting it (see cron/heatDecay.js)
HEAT_DECAY_AMOUNT=2
HEAT_DECAY_INTERVAL_MS=120000
