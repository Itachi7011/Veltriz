# ==============================
# VELTRIZ ECONOMY SERVICE - ENV
# ==============================

APP_NAME=Veltriz
NODE_ENV=development
PORT=5001

# Frontend / other-service URLs allowed to call this service or connect sockets
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
GAME_WORLD_SERVICE_URL=http://localhost:5002

# MongoDB — SAME cluster/database as auth-service (shared DB, separate collections)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/veltriz

# JWT — MUST be the exact same value as auth-service's JWT_SECRET.
# This service verifies player tokens locally; it never calls auth-service.
JWT_SECRET=change_this_super_long_random_secret

# Internal service-to-service key — used by admin-service (price overrides,
# wallet adjustments, economy stats), crime-service (crediting successful
# crime payouts), and game-world-service (debiting the Gym's workout fee) to
# call this service's /api/internal/* routes. Generate a long random string
# and put the SAME value in every other service's env as INTERNAL_API_KEY.
INTERNAL_API_KEY=change_this_to_a_long_random_shared_secret

# ---- Casino tuning (Coin Flip) ----
# Bet size bounds, in VC
CASINO_MIN_BET=10
CASINO_MAX_BET=500
# Player's win probability per flip (0-1). A win pays 2x the bet.
CASINO_WIN_CHANCE=0.47
# Anti-spam cooldown between bets, in ms — not a real gameplay throttle
CASINO_COOLDOWN_MS=3000

# ---- Economy tuning ----
# How often (ms) the price engine nudges marketplace prices
PRICE_TICK_INTERVAL_MS=60000
# Max % a price can drift per tick (volatility dampener, prevents chaos)
PRICE_MAX_DRIFT_PERCENT=2

# Starting wallet balance for brand-new citizens (Veltriz Coins)
STARTING_BALANCE_POOR=500
STARTING_BALANCE_MIDDLE=2500
STARTING_BALANCE_RICH=15000

# Optional external reference feed (free, no API key needed):
# frankfurter.app gives real ECB exchange rates — used only as a soft
# reference signal the admin can see; it never auto-changes game prices.
ENABLE_EXTERNAL_REFERENCE_FEED=true
EXTERNAL_FEED_INTERVAL_MS=3600000
