# ALL REST API calls in this app use RELATIVE paths (e.g. /api/auth/login)
# and are NEVER driven by an env var. Routing is handled entirely by:
#   - vite.config.js's proxy config in development
#   - netlify.toml's redirects in production
# Do not add VITE_AUTH_SERVICE_URL / VITE_ECONOMY_SERVICE_URL as a base URL
# for axios — that bypasses the proxy/redirects and causes CORS errors.
#
# The ONLY exception is Socket.IO connections, because Netlify's redirect
# proxying is HTTP-only and cannot proxy WebSocket upgrades. Those two
# vars below exist for that reason alone, and only need to be set in
# production (both already default to the right localhost port in dev,
# so this file can stay empty for local development).
VITE_ECONOMY_SERVICE_URL=https://veltriz-economy-service.onrender.com
VITE_GAME_WORLD_SERVICE_URL=https://veltriz-game-world-service.onrender.com
